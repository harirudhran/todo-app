# Copy this file to .env and fill in your own values
PORT=5000

# Get this from MongoDB Atlas (see GUIDE.md) or use a local MongoDB URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/todoapp?retryWrites=true&w=majority

# Any long random string. You can generate one at https://randomkeygen.com
JWT_SECRET=replace_this_with_a_long_random_secret_string
